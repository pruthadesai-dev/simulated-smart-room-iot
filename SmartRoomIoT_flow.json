    {
        "id": "09d468a482675e02",
        "type": "function",
        "z": "ed2d80638a720f85",
        "name": "Temperature Alert",
        "func": "const temperature = msg.payload.temperature;\n\nif (temperature >= 32) {\n    msg.payload = \"WARNING: High temperature - \"\n        + temperature + \" °C\";\n} else {\n    msg.payload = \"Normal temperature - \"\n        + temperature + \" °C\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
